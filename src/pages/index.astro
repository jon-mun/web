---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredIds = ['siteprotect', 'dewabuilder', 'walpix-beam'];
const projects = featuredIds
	.map((id) => allProjects.find((p) => p.id === id))
	.filter((p): p is NonNullable<typeof p> => p !== undefined);
---

<Layout>
	<section class="mb-16">
		<h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Hello, I'm Jonathan Edmund.</h1>
		<p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
			I'm a Software Engineer, Tech Lead, and AI Engineer based in Indonesia. I architect high-velocity platforms, integrate AI into production environments, and lead technical teams to build resilient infrastructure.
		</p>
	</section>

	<section>
		<h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">Featured Projects</h2>
		<div class="space-y-8">
			{
				projects.map((project) => (
					<article class="group">
						<a href={`/projects/${project.id}/`} class="block">
							<h3 class="text-xl font-semibold text-gray-900 dark:text-white group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors">
								{project.data.title}
							</h3>
							<p class="text-gray-600 dark:text-gray-400 mt-2">{project.data.description}</p>
							<div class="mt-3 flex flex-wrap gap-2">
								{project.data.tags.map((tag) => (
									<span class="inline-block bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 text-xs px-2 py-1 rounded">
										{tag}
									</span>
								))}
							</div>
						</a>
					</article>
				))
			}
		</div>
		<div class="mt-8">
			<a href="/projects" class="text-gray-900 dark:text-white font-medium hover:text-gray-600 dark:hover:text-gray-300 underline underline-offset-4 decoration-gray-400 hover:decoration-gray-600 dark:decoration-gray-600 dark:hover:decoration-gray-400 transition-all">
				View all projects →
			</a>
		</div>
	</section>
</Layout>
